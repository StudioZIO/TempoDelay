{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run build && npm run verify:dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/contact",
      "destination": "https://studiozio.vercel.app/contact",
      "permanent": true
    }
  ]
}
